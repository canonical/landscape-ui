{
  "name": "landscape-ui",
  "private": true,
  "version": "26.10.0.1081",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run lint && pnpm run tcm:run && tsc && vite build",
    "build:e2e": "pnpm run build --mode e2e",
    "lint": "eslint --fix src e2e",
    "preview": "vite preview",
    "test": "pnpm exec playwright test",
    "test:saas": "VITE_SELF_HOSTED_ENV=false pnpm exec playwright test --project=saas",
    "test:self-hosted": "VITE_SELF_HOSTED_ENV=true pnpm exec playwright test --project=self-hosted",
    "test:ui": "pnpm exec playwright test --ui",
    "vitest": "vitest",
    "coverage": "vitest run --coverage",
    "coverage-report": "tsx src/tests/aggregate-coverage.ts",
    "coverage:full": "pnpm run coverage && pnpm run coverage-report",
    "test:codegen": "pnpm exec playwright codegen",
    "test:report": "pnpm exec playwright show-report",
    "tcm:run": "tcm \"src/**\" --pattern *.module.scss",
    "tcm:watch": "pnpm tcm:run --watch"
  },
  "dependencies": {
    "@canonical/landscape-openapi": "0.0.80",
    "@canonical/react-components": "4.9.0",
    "@monaco-editor/react": "4.7.0",
    "@sentry/react": "10.70.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "classnames": "2.5.1",
    "downshift": "9.4.0",
    "formik": "2.4.9",
    "monaco-editor": "0.56.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "usehooks-ts": "3.1.1",
    "vanilla-framework": "4.56.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.12.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-table": "7.7.20",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "sass-embedded": "1.100.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.1",
    "tsx": "4.23.12",
    "typed-css-modules": "0.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
