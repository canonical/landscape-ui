{
  "name": "landscape-ui",
  "private": true,
  "version": "26.10.0.1081",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm run lint && pnpm run tcm:run && tsc && vite build",
    "build:e2e": "pnpm run build --mode e2e",
    "lint": "eslint --fix src e2e",
    "preview": "vite preview",
    "test": "pnpm exec playwright test",
    "test:saas": "VITE_SELF_HOSTED_ENV=false pnpm exec playwright test --project=saas",
    "test:self-hosted": "VITE_SELF_HOSTED_ENV=true pnpm exec playwright test --project=self-hosted",
    "test:ui": "pnpm exec playwright test --ui",
    "vitest": "vitest",
    "coverage": "vitest run --coverage",
    "coverage-report": "tsx src/tests/aggregate-coverage.ts",
    "coverage:full": "pnpm run coverage && pnpm run coverage-report",
    "eval:collect": "tsx src/tests/contract-coverage/eval-loop/collect-gaps.ts",
    "eval:suggest": "tsx src/tests/contract-coverage/eval-loop/run-eval-loop.ts",
    "eval:full": "pnpm run coverage:full && pnpm run eval:collect && pnpm run eval:suggest",
    "test:codegen": "pnpm exec playwright codegen",
    "test:report": "pnpm exec playwright show-report",
    "tcm:run": "tcm \"src/**\" --pattern *.module.scss",
    "tcm:watch": "pnpm tcm:run --watch"
  },
  "dependencies": {
    "@canonical/ds-assets": "0.44.1",
    "@canonical/landscape-openapi": "0.0.86",
    "@canonical/react-components": "4.12.1",
    "@canonical/react-ds-global": "0.44.1",
    "@canonical/react-ds-global-form": "0.44.1",
    "@canonical/styles": "0.44.1",
    "@monaco-editor/react": "4.7.0",
    "@sentry/react": "10.76.2",
    "@tanstack/react-query": "5.104.2",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "downshift": "9.4.0",
    "formik": "2.4.9",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "usehooks-ts": "3.1.1",
    "vanilla-framework": "4.59.0",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@canonical/pragma-cli": "0.44.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-table": "7.7.20",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "sass": "1.105.1",
    "sass-embedded": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.2",
    "tsx": "4.23.15",
    "typed-css-modules": "0.9.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
