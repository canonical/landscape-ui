{
  "name": "@canonical/terrazzo-lsp",
  "version": "0.8.1",
  "description": "Language server providing CSS custom property intelligence for design token workflows. Includes completions, hover, diagnostics, go-to-definition, rename, document colours, and workspace symbols.",
  "type": "module",
  "license": "LGPL-3.0",
  "author": {
    "email": "webteam@canonical.com",
    "name": "Canonical Webteam"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/canonical/design-tokens"
  },
  "bugs": {
    "url": "https://github.com/canonical/design-tokens/issues"
  },
  "homepage": "https://github.com/canonical/design-tokens#readme",
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "language-server",
    "lsp",
    "canonical",
    "dtcg",
    "vscode"
  ],
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./runtime/detectRuntime": {
      "types": "./dist/types/runtime/detectRuntime.d.ts",
      "import": "./dist/esm/runtime/detectRuntime.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "terrazzo-lsp": "./dist/esm/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "jq '{version}' package.json > src/version.json && bun run build:tsc",
    "build:all": "bun run build",
    "build:tsc": "tsc -p tsconfig.build.json",
    "check": "bun run check:biome && bun run check:ts && bun run check:webarchitect",
    "check:webarchitect": "webarchitect library",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@canonical/token-types": "^0.8.1",
    "@lezer/common": "^1.5.1",
    "@lezer/css": "^1.3.4",
    "colorjs.io": "^0.7.0"
  },
  "devDependencies": {
    "@canonical/webarchitect": "^0.31.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "gitHead": "814ea3c12447bac8ad31ff67142e63584d663986"
}
